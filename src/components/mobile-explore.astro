---
import  KitchenIcon  from "./icons/KitchenIcon.astro";
import  WardrobesIcon  from "./icons/WardrobesIcon.astro";
import  MaterialsIcon  from "./icons/MaterialsIcon.astro";
import  ProcessIcon  from "./icons/ProcessIcon.astro";
import  GalleryIcon  from "./icons/GalleryIcon.astro";
import  ConsultIcon  from "./icons/ConsultIcon.astro";

const normalizePath = (path: string) => {
  if (path === "/") return "/";
  return path.replace(/\/+$/, "");
};

const pathname = normalizePath(Astro.url.pathname);

const links = [
  {
    href: "/kitchens",
    label: "Kitchens",
    icon: KitchenIcon
  },
  {
    href: "/wardrobes",
    label: "Wardrobes",
    icon: WardrobesIcon
  },
  { href: "/alloy", label: "Materials", icon: MaterialsIcon },
  { href: "/process", label: "Process", icon: ProcessIcon},
  { href: "/gallery", label: "Gallery", icon: GalleryIcon},
  { href: "/consult", label: "Consult", icon: ConsultIcon},
];
---

<div class="mobile-explore">
  {
    links.map(({ href, label, icon: Icon }) => {
      const isCurrent = pathname === href;
      
      return isCurrent ? (
        <span class = 'link mobile-explore-current'>
          <div class="mobile-explore-task">
            <Icon/>
            <div class="mobile-explore-text">{label}</div>
          </div>
        </span>
      ) : (
        <a class = 'link' href= {href}>
          <div class="mobile-explore-task">
            <Icon/>
            <div class="mobile-explore-text">{label}</div>
          </div>
        </a>
      )
      
      ;
    })
  }
</div>

