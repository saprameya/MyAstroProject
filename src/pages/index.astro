---
import BaseLayout  from "../layouts/BaseLayout.astro";

---

<BaseLayout>
       <div class="hero">
          <div class="hero-img initial">
            <picture>
              <source
              srcset="images/landing-mobile.webp"
              media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)"
              width="1122" height="1042"/>
              <img src="images/landing-stretched.webp" alt="Image showing kitchen and bedroom" width="1920" height="1080" />
            </picture>

            <div class="kitchen-overlay">
              <picture>
                <source 
                srcset="images/kitchen-highlight-mobile.webp" 
                media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1122" />
                <img src="images/kitchen-highlight-stretched.webp" alt="" aria-hidden="true" width="1920" />
              </picture>
            </div>
            <div class="wardrobe-overlay">
              <picture>
                <source 
                srcset="images/wardrobe-highlight-mobile.webp"
                 media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1119" />
                <img src="images/wardrobe-highlight-stretched.webp" alt="" aria-hidden="true" width="1920" />
              </picture>
            </div>
            <div class="bedroom-overlay">
              <picture>
                <source 
                srcset="images/bedroom-highlight-mobile.webp" 
                media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1122" />
                <img src="images/bedroom-highlight-stretched.webp" alt="" aria-hidden="true" width="1920" />
              </picture>
            </div>
          </div>
          <div class="tagline init">
            <div class="tagline-content">
              <h1 class="tagline-heading">Every home knows a <em>different</em> story.</h1>
              <div class="hero-paragraph">
                <div class="hero-subtitle">The best homes know the people who live in them.</div>
              </div>
            </div>
            <div class="options">
              <div class="learn-more learn-more-text link">Discover the Vision</div>
            </div>
          </div>
          <div class="countdown">
            <span class="current-span"></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
          <div class="slides">
            <div class="slide slide2 kitchen-slide" data-slide-num="1">
              <p>The kitchen knows that recipes are only part of what happens here.</p>
              <p>It remembers conversations, celebrations, and quiet cups of tea.</p>
            </div>
            <div class="slide slide3 wardrobe-slide" data-slide-num="2">
              <p>The wardrobe knows that every morning begins differently.</p>
              <p>Some mornings need order. Others need a little more time.</p>
            </div>

            <div class="slide slide4 bedroom-slide" data-slide-num="3">
              <p>The bedroom is where we finally slow down.</p>
              <p>Because every home should feel like it knows you.</p>
            </div>
            <div class="slide slide1" data-slide-num="4">
              <p>Every home tells the story of the people who live there.</p>
              <div class="begin-story link">
                <a href="coming-soon.html" class="begin-story-text"> Now let's get to your's </a>
              </div>
            </div>
          </div>
          <div class="controls">
            <div class="progress">1/4</div>
            <div class="close link">&times;</div>
            <div class="slide-controls">
              <div class="next link">
                <div class="next-arrow">
                  <svg viewBox="0 0 6.4371204 10.149022">
                    <g style="fill-opacity: 1" transform="translate(-61.355299,-35.864323)">
