---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/kitchen-style.css"
---

<BaseLayout bodyClass="kitchens-body" mainClass="kitchens-main">
  <div class="link scroll">
    Scroll to Explore the Field note
    <span class="arrow"
      ><svg xmlns="http://www.w3.org/2000/svg" width="18" height="12" viewBox="0 0 31.887 15.912">
        <path
          d="m693.24 657.027 15.599 14.86 15.598-14.86"
          style="
                opacity: 0.721973;
                fill: none;
                fill-opacity: 0.85;
                fill-rule: evenodd;
                stroke-linecap: butt;
                stroke-miterlimit: 2;
                stroke-dasharray: none;
                stroke-dashoffset: 20;
                stroke-opacity: 1;
              "
          transform="translate(-692.895 -656.665)"></path></svg
      ></span
    >
  </div>
  <div class="screen screen-title">
    <div class="fn-text-wrapper">
      <div class="fn-text">
        <h2>Field note</h2>
        <h1>
          The <span>Evening </span>
          <br />
          Sun
        </h1>
        <p>We noticed something before we designed anything.</p>
      </div>
    </div>
  </div>

  <div class="screen observed" id="observed">
    <h2>Observed</h2>
    <div class="fn-text-wrapper">
      <div class="fn-text">
        <div>
          <h3>Why did everyone keep moving here?</h3>
        </div>
        <div>
          <p>
            First visit. <br />
            Walls marked. <br />
            Openings measured.
          </p>
          <p class="observed-emphasis">Everyone gravitated towards the window.</p>
          <p>
            Third meeting. <br />
            Materials discussed.
          </p>
          <p class="observed-emphasis">Everyone gravitated towards the window. <em>Again</em>.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="screen realisation">
    <div class="fn-text-wrapper">
      <div class="fn-text">
        <h2>REALISATION</h2>
        <h3>It wasn't the window.</h3>
        <p>It was the <em>evening sun</em>.</p>
        <p class="time-of-day">5:30pm WEST</p>
      </div>
    </div>
  </div>

  <div class="screen designed">
    <h2>Designed</h2>

    <div class="fn-text-wrapper">
      <div class="fn-text">
        <h3>We moved the island.</h3>
        <div>
          <p>Softened the palette so the evening light had something to bounce off.</p>
          <p>And let the sun shape the kitchen's second act.</p>
          <p>We simply protected what they already loved.</p>
        </div>
      </div>
    </div>
    <div class="fn-image">
      <img src="/images/floor-plan.webp" alt="image showing a floor plan of a kitchen" width="1342" height="1172" />
    </div>
  </div>

  <div class="screen experience">
    <picture>
      <source srcset="/images/family-silhouette-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1177" height="1336" />

      <img src="/images/family-silhouette-laptop.webp" alt="image showing a family at a kitchen table" width="1448" height="1086" />
    </picture>

    <div class="fn-text">
      <h2>The Experience</h2>
      <div class="experience-fn-text-wrapper">
        <div class="experience-h3">
          <h3>
            Understanding the people who live in the home&mdash; <br />
            that is what sets NuSpace apart.
          </h3>
        </div>
        <div class="experience-text">
          <p>Beauty is non-negotiable. Design is a given.</p>
          <p>Ergonomics is imperative. Storage is intrinsic.</p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const screenElements = document.querySelectorAll(".screen");
    const scrollElement = document.querySelector(".scroll");
    const arrow = document.querySelector(".arrow");
    const observed = document.querySelector(".observed");

    let linkClicked = true;
    let screenIndex;

    window.addEventListener("scroll", () => {
      scrollElement.classList.add("clicked");
    });

    scrollElement.addEventListener("click", () => {
      scrollElement.classList.add("clicked");

      if (linkClicked) {
        screenIndex = getScreenInViewport() + 1;
        if (screenIndex < screenElements.length) {
          if (screenIndex < screenElements.length) {
            screenElements[screenIndex].scrollIntoView();
          }
        }
      }
    });

    const observerOptions = {
      root: null, // Use the browser viewport
      threshold: 0.5, // Trigger when 10% of the element is visible
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        // If the element is visible in the viewport
        if (entry.isIntersecting) {
          entry.target.classList.add("current");
          if (Array.from(screenElements).indexOf(entry.target) === screenElements.length - 1) {
            arrow.style.visibility = "hidden";
          } else {
            arrow.style.visibility = "visible";
          }

          // Optional: Stop watching if you only want to add the class once
          // observer.unobserve(entry.target);
        } else {
          // Optional: Remove the class if it goes out of view
          entry.target.classList.remove("current");
        }
      });
    }, observerOptions);

    screenElements.forEach((screen) => {
      observer.observe(screen);
    });

    const screens = document.querySelectorAll(".screen");

    function getScreenInViewport() {
      const viewportCenter = window.innerHeight / 2;

      let closestIndex = -1;
      let closestDistance = Infinity;

      screenElements.forEach((screen, index) => {
        const rect = screen.getBoundingClientRect();

        // Center of this screen
        const screenCenter = rect.top + rect.height / 2;

        // Distance between screen center and viewport center
        const distance = Math.abs(screenCenter - viewportCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    }

    function setArrowVisibility() {
      if (screenIndex === screenElements.length - 1) {
      } else {
        arrow.style.visibility = "visible";
      }
    }
  </script>
</BaseLayout>


