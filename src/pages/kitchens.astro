---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="link scroll">
    Scroll to Explore the Field note
    <span class="arrow"
      ><svg xmlns="http://www.w3.org/2000/svg" width="18" height="12" viewBox="0 0 31.887 15.912">
        <path
          d="m693.24 657.027 15.599 14.86 15.598-14.86"
          style="
                opacity: 0.721973;
                fill: none;
                fill-opacity: 0.85;
                fill-rule: evenodd;
                stroke-linecap: butt;
                stroke-miterlimit: 2;
                stroke-dasharray: none;
                stroke-dashoffset: 20;
                stroke-opacity: 1;
              "
          transform="translate(-692.895 -656.665)"></path></svg
      ></span
    >
  </div>
  <div class="screen screen-title">
    <div class="fn-text-wrapper">
      <div class="fn-text">
        <h2>Field note</h2>
        <h1>
          The <span>Evening </span>
          <br />
          Sun
        </h1>
        <p>We noticed something before we designed anything.</p>
      </div>
    </div>
  </div>

  <div class="screen observed" id="observed">
    <h2>Observed</h2>
    <div class="fn-text-wrapper">
      <div class="fn-text">
        <div>
          <h3>Why did everyone keep moving here?</h3>
        </div>
        <div>
          <p>
            First visit. <br />
            Walls marked. <br />
            Openings measured.
          </p>
          <p class="observed-emphasis">Everyone gravitated towards the window.</p>
          <p>
            Third meeting. <br />
            Materials discussed.
          </p>
          <p class="observed-emphasis">Everyone gravitated towards the window. <em>Again</em>.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="screen realisation">
    <div class="fn-text-wrapper">
      <div class="fn-text">
        <h2>REALISATION</h2>
        <h3>It wasn't the window.</h3>
        <p>It was the <em>evening sun</em>.</p>
        <p class="time-of-day">5:30pm WEST</p>
      </div>
    </div>
  </div>

  <div class="screen designed">
    <h2>Designed</h2>

    <div class="fn-text-wrapper">
      <div class="fn-text">
        <h3>We moved the island.</h3>
        <div>
          <p>Softened the palette so the evening light had something to bounce off.</p>
          <p>And let the sun shape the kitchen's second act.</p>
          <p>We simply protected what they already loved.</p>
        </div>
      </div>
    </div>
    <div class="fn-image">
      <img src="/images/floor-plan.webp" alt="image showing a floor plan of a kitchen" width="1342" height="1172" />
    </div>
  </div>

  <div class="screen experience">
    <picture>
      <source srcset="/images/family-silhouette-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1177" height="1336" />

      <img src="/images/family-silhouette-laptop.webp" alt="image showing a family at a kitchen table" width="1448" height="1086" />
    </picture>

    <div class="fn-text">
      <h2>The Experience</h2>
      <div class="experience-fn-text-wrapper">
        <div class="experience-h3">
          <h3>
            Understanding the people who live in the home&mdash; <br />
            that is what sets NuSpace apart.
          </h3>
        </div>
        <div class="experience-text">
          <p>Beauty is non-negotiable. Design is a given.</p>
          <p>Ergonomics is imperative. Storage is intrinsic.</p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const screenElements = document.querySelectorAll(".screen");
    const scrollElement = document.querySelector(".scroll");
    const arrow = document.querySelector(".arrow");
    const observed = document.querySelector(".observed");

    let linkClicked = true;
    let screenIndex;

    window.addEventListener("scroll", () => {
      scrollElement.classList.add("clicked");
    });

    scrollElement.addEventListener("click", () => {
      scrollElement.classList.add("clicked");

      if (linkClicked) {
        screenIndex = getScreenInViewport() + 1;
        if (screenIndex < screenElements.length) {
          if (screenIndex < screenElements.length) {
            screenElements[screenIndex].scrollIntoView();
          }
        }
      }
    });

    const observerOptions = {
      root: null, // Use the browser viewport
      threshold: 0.5, // Trigger when 10% of the element is visible
    };

    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        // If the element is visible in the viewport
        if (entry.isIntersecting) {
          entry.target.classList.add("current");
          if (Array.from(screenElements).indexOf(entry.target) === screenElements.length - 1) {
            arrow.style.visibility = "hidden";
          } else {
            arrow.style.visibility = "visible";
          }

          // Optional: Stop watching if you only want to add the class once
          // observer.unobserve(entry.target);
        } else {
          // Optional: Remove the class if it goes out of view
          entry.target.classList.remove("current");
        }
      });
    }, observerOptions);

    screenElements.forEach((screen) => {
      observer.observe(screen);
    });

    const screens = document.querySelectorAll(".screen");

    function getScreenInViewport() {
      const viewportCenter = window.innerHeight / 2;

      let closestIndex = -1;
      let closestDistance = Infinity;

      screenElements.forEach((screen, index) => {
        const rect = screen.getBoundingClientRect();

        // Center of this screen
        const screenCenter = rect.top + rect.height / 2;

        // Distance between screen center and viewport center
        const distance = Math.abs(screenCenter - viewportCenter);

        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = index;
        }
      });

      return closestIndex;
    }

    function setArrowVisibility() {
      if (screenIndex === screenElements.length - 1) {
      } else {
        arrow.style.visibility = "visible";
      }
    }
  </script>
</BaseLayout>

<style>
  body {
    /* variable declarations */
    /* color variables */
    --accent-font-clr: hsl(30, 20%, 98%);
    --tagline-font-clr: hsl(26, 33%, 21%);
    --bkgrnd-clr1: hsl(37, 24%, 76%);
    --bkgrnd-clr1: hsl(23, 59%, 92%);
    --bkgrnd-clr2: hsl(30, 24%, 73%);
    --highlight-clr: hsl(39, 100%, 58%);

    /* number variables */
    --max-width: 1920px;

    @media (orientation: landscape) and (min-width: 1000px) and (min-height: 500px) {
      --header-height: 45px;
    }
  }

  :global(body) {
    max-width: 100%;

    height: 100%;
  }

 :global(.body-wrapper) {
    max-width: 98%;
  }

  :global(main) {
    position: relative;
    padding-top: --header-height;
    max-width: 100%;
    color: var(--tagline-font-clr);
    font-size: clamp(1rem, 1rem + 0.5vw, 1.5rem);
    max-height: none;
    @media (width <= 1024px) and (max-height: 600px) and (max-height: 600px), (orientation: portrait) {
      /* padding-top: clamp(100px, calc(15vh + 1.5rem), 150px); */
    }
  }

  .screen {
    position: relative;
    display: flex;

    transform-origin: top;
    opacity: 0.05;
    overflow-y: hidden;
    margin-bottom: 2rem;

    scroll-snap-align: center;
    scroll-margin-top: 15vh;
    @media (width <= 1024px) and (max-height: 600px) and (max-height: 600px), (orientation: portrait) {
      flex-direction: column;
      gap: 1rem;
      padding-inline: 1rem;
    }
  }

  .screen.current {
    animation: screen-fade 3s forwards;
  }

  @keyframes screen-fade {
    100% {
      opacity: 1;
    }
  }

  .fn-image {
    width: 100%;
    height: 100%;
  }

  .fn-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fn-text-wrapper {
    width: clamp(250px, 35vw, 400px);
    min-width: 350px;
    padding-top: 5rem;
    min-height: 100%;
    @media (width <= 1024px) and (max-height: 600px) and (max-height: 600px), (orientation: portrait) {
      min-width: 0;
      width: 50%;
      padding-top: 0;
    }
  }

  .fn-text h1 {
    margin-block: 4rem;
    font-size: clamp(2rem, 1.554rem + 2.038vw, 4rem);
  }

  h2 {
    text-transform: uppercase;
    font-size: 1.5rem;
  }
  .fn-text h3 {
    margin-block: 2rem;
    font-size: clamp(1.5rem, 1.8rem + 0.2vh, 3rem);

    @media (width <= 1024px) and (max-height: 600px) and (max-height: 600px), (orientation: portrait) {
      margin-block: 0;
      width: 100%;
    }
  }

  .fn-text h1 span {
    font-style: italic;
    color: var(--highlight-clr);
  }

  .fn-text {
    max-width: 90%;
    height: 100%;
    margin-inline: auto;

    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      margin: 0;
      padding-top: 1rem;
    }
  }

  .time-of-day {
    position: absolute;
    font-size: 0.8rem;
    width: 20%;

    bottom: 2rem;
    /* @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
    bottom: unset;
  } */
  }

  .fn-text ul {
    padding-left: 1rem;
  }

  .fn-text li {
    padding-bottom: 0.8rem;
  }

  .screen-title {
    background: url(/images/kitchen-window-view.webp) center / cover no-repeat;
    color: var(--accent-font-clr);
    min-height: 80vh;

    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      background: url(/images/kitchen-landing-mobile.webp) left top / cover no-repeat;
    }
  }

  .screen-title::after {
    content: "";
    width: 100%;
    inset: 0;
    position: absolute;
    background: linear-gradient(transparent, var(--tagline-font-clr));
    background: var(--tagline-font-clr);
    mask: linear-gradient(transparent 70%, black 80%, black);
    mix-blend-mode: multiply;
  }

  .screen-title .fn-text {
    margin-left: 5vw;
    margin-top: calc(var(--header-height));
  }

  .screen-title .fn-text-wrapper {
    margin-bottom: 5rem;
    /* margin-left: 5vw; */
    z-index: 1;

    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      margin: 0;
      padding: 0;
    }
  }

  .screen-title .fn-text-wrapper h2 {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      width: 50vw;
      margin-block: 5vh;
    }
  }

  .screen-title .fn-text-wrapper h2 {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      margin-block: 2rem;
    }
  }

  .scroll {
    color: var(--accent-font-clr);
    font-size: 0.8rem;
    text-transform: uppercase;
    position: absolute;
    /* margin-left: 5vw; */
    width: 100%;
    inset-block-start: 75vh;
    text-align: center;
    z-index: 3;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      left: 0;
      bottom: 5rem;
    }
  }

  .scroll.clicked {
    position: sticky;
    display: block;
    text-align: right;
    right: 0;

    visibility: hidden;
  }
  .scroll.clicked .arrow {
    visibility: visible;
    stroke: var(--highlight-clr);
    stroke-width: 4;
    padding: 0.75rem 0.5rem;
    margin-right: 1rem;
    border-radius: 50%;
    background: hsl(from var(--tagline-font-clr) h s l / 0.5);
  }
  .arrow {
    display: inline-block;
    stroke: var(--accent-font-clr);
    stroke-width: 2;
    padding-left: 0.5rem;
  }

  main .task-bar {
    bottom: 0;
  }

  .observed h2,
  .designed h2 {
    margin-left: 5vw;
  }

  .observed {
    height: auto;
    flex-direction: column;
  }

  .observed .fn-text-wrapper {
    width: 100%;
  }

  .observed h3 {
    font-size: 2rem;
    margin-block: 5rem;
  }

  .observed .fn-text,
  .experience .fn-text {
    width: 100%;
    display: flex;
    justify-content: start;
    gap: 10vw;
  }

  .observed .fn-text {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      flex-direction: column;
      gap: 1rem;
    }
  }

  .observed h2 {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      margin-left: 0;
    }
  }
  .observed h3 {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      margin-block: 0;
    }
  }

  .observed .fn-text p {
    line-height: 1.5rem;
    padding-block: 0.5rem;
  }

  .observed-emphasis {
    font-weight: 700;
  }
  .observed,
  .designed {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      min-height: fit-content;
      padding-bottom: 2rem;
    }
  }

  .realisation {
    background: url(/images/Sunset.webp) center / cover no-repeat;
    mix-blend-mode: multiply;
    min-height: 80vh;
  }

  .realisation::after {
    content: "";
    position: absolute;
    inset: 0;
    background: hsl(25, 65%, 49%);
    mask: linear-gradient(to left, transparent 70%, black 100%);
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      background: linear-gradient(to right, hsl(27, 54%, 89%), transparent);
      background: linear-gradient(to bottom, hsl(25, 65%, 49%) 10%, transparent 40%, transparent 100%);
      mask: linear-gradient(to left, transparent 5%, transparent 15%, transparent 30%, transparent 50%, black 70%, black);
    }
  }

  .realisation .fn-text-wrapper {
    margin: 0;
    width: 50vw;
    margin-block: 5vh;
    padding: 0;
    z-index: 5;
    /* color: var(--accent-font-clr); */
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      min-height: 100%;
      margin-block: 0;
    }
  }

  .realisation .fn-text h2 {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      margin-block: 5vh;

      color: var(--tagline-font-clr);
    }
  }

  .realisation h3 {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      margin-block: 1rem;
    }
  }

  .designed {
    min-height: unset;
    height: 80vh;

    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      flex-direction: column;
      height: 200%;
    }
  }

  .designed .fn-text-wrapper {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .designed .fn-text {
    width: fit-content;
    height: fit-content;
  }

  .designed p {
    padding-block: 1rem;
  }

  .experience {
    height: 80vh;
    flex-direction: column;

    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      gap: 0;
      padding: 0;
      height: calc(60vh + 3rem);
      background: var(--tagline-font-clr);
    }
  }

  .experience .fn-text {
    position: absolute;
    inset: 0;
    padding: 1rem;
    max-width: 100%;
    display: grid;
    grid-template-columns: 1fr;
    color: var(--accent-font-clr);
    align-items: center;
    z-index: 15;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      height: 57vh;
      grid-template-rows: 20vh 1fr;
    }
  }

  .experience h2 {
    grid-area: 1/1/2/2;

    align-self: self-start;
    justify-self: self-start;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      grid-area: 1/1/2/2;
      align-self: start;
      width: 100%;
    }
  }

  .experience-h3 {
    grid-area: 2/1/3/2;
    align-self: start;
    padding-bottom: 2rem;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      grid-area: 2/1/3/2;
      width: 100%;
    }
  }

  .experience-text {
    grid-area: 2/1/3/2;
    align-self: self-end;
  }

  .experience img {
    width: 100%;
    max-height: 75%;
    object-fit: cover;
  }

  .experience p {
    padding-block: 0.5rem;
  }

  .experience::after {
    content: "";
    position: absolute;

    inset: 0;
    background: linear-gradient(var(--tagline-font-clr) 5%, transparent 10%, var(--tagline-font-clr));
    background: linear-gradient(var(--tagline-font-clr) 10%, transparent 30%, var(--tagline-font-clr) 65%, transparent);

    mix-blend-mode: multiply;
    z-index: 5;
  }

  main::after {
    @media (width < 500px) {
      content: "";
      position: absolute;
      inset: 0;
      min-height: 10vh;
      top: 100%;
    }
  }

  /* ******************************************************************************** */
</style>
