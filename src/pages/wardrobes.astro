---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="wardrobes-hero">
    <div class="wardrobes-hero-img-wrapper">
      <picture>
        <source srcset="/public/images/wardrobe-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="941" height="1082" />

        <source srcset="/public/images/wardrobe-landing-laptop-narrower.webp" media="(orientation: landscape)  and (max-height: 720px) and (min-width: 1000px)" width="1672" height="793" />

        <img src="/public/images/wardrobe-landing-laptop.webp" alt="image showing a modern, organised, sleek wardrobe" width="1920" height="1080" fetchpriority="high" width="1672" height="941" />
      </picture>
    </div>
    <div class="wardrobes-hero-text">
      <h1>
        One <br />
        Wardrobe. <br />
        Five Lives.
      </h1>
      <p>Because no two wardrobes should be designed the same way.</p>
      <a href="#card-container" class="hero-cta">
        <p>Same space. Endless possibilities.</p>
        <div class="cta-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="31.887" height="15.912" viewBox="0 0 31.887 15.912">
            <path
              d="m693.24 657.027 15.599 14.86 15.598-14.86"
              style="
                    opacity: 0.721973;
                    fill: none;
                    fill-opacity: 0.85;
                    fill-rule: evenodd;
                    stroke-linecap: butt;
                    stroke-miterlimit: 2;
                    stroke-dasharray: none;
                    stroke-dashoffset: 20;
                    stroke-opacity: 1;
                  "
              transform="translate(-692.895 -656.665)"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>

  <div class="card-container-wrapper">
    <div class="card-container" id="card-container">
      <div class="card minimalist">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/public/images/minimilist-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/public/images/minimilist-laptop.webp" alt="image showing a wardrobe for a minimalist" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE MINIMALIST</h2>
          <p class="main-point">Less, deliberately.</p>
          <p>Only what you need. Everything has its place.</p>
        </div>
      </div>
      <div class="card collector">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/public/images/collector-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/public/images/collector-laptop.webp" alt="image showing a wardrobe for a collector" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE COLLECTOR</h2>
          <p class="main-point">Make room for what matters.</p>
          <p>Because the things you love deserve to be seen—and stored properly.</p>
        </div>
      </div>
      <div class="card traveller">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/public/images/traveller-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/public/images/traveller-laptop.webp" alt="image showing a wardrobe for a traveller" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE TRAVELLER</h2>
          <p class="main-point">Come home. Unpack. Breathe.</p>
          <p>A place for the suitcase. A place for the everyday.</p>
        </div>
      </div>
      <div class="card couple">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/public/images/couple-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/public/images/couple-laptop.webp" alt="image showing a wardrobe for a couple" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE COUPLE</h2>
          <p class="main-point">Two people. One wardrobe.</p>
          <p>Different routines. Different needs. One beautifully resolved space.</p>
        </div>
      </div>
      <div class="card family">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/public/images/family-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/public/images/family-laptop.webp" alt="image showing a wardrobe for a family" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE Family</h2>
          <p class="main-point">Life changes. Storage should too.</p>
          <p>School today. Work tomorrow. More life, eventually.</p>
        </div>
      </div>
    </div>
    
  </div>
  <div class="carousel-buttons"></div>

  

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.querySelector(".card-container-wrapper");
    const cards = [...document.querySelectorAll(".card")];
    const buttonsContainer = document.querySelector(".carousel-buttons");

    if (!carousel || !buttonsContainer || cards.length === 0) {
      console.warn("Carousel elements were not found.");
      return;
    }

    const buttons = [];

    cards.forEach((card, index) => {
      const button = document.createElement("button");

      button.type = "button";
      button.className = "carousel-button";
      button.setAttribute("aria-label", `Go to card ${index + 1}`);

      if (index === 0) {
        button.classList.add("active");
      }

      button.addEventListener("click", () => {
        const carouselCenter = carousel.clientWidth / 2;
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;

        carousel.scrollTo({
          left: cardCenter - carouselCenter,
          behavior: "smooth",
        });

        updateActiveButton(index);
      });

      buttonsContainer.appendChild(button);
      buttons.push(button);
    });

    function updateActiveButton(index) {
      buttons.forEach((button, buttonIndex) => {
        button.classList.toggle("active", buttonIndex === index);
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (!visibleEntry) return;

        const index = cards.indexOf(visibleEntry.target);

        cards.forEach((card) => {
          card.classList.remove("current");
        });

        visibleEntry.target.classList.add("current");
        updateActiveButton(index);
      },
      {
        root: carousel,
        threshold: [0.6],
      },
    );

    cards.forEach((card) => observer.observe(card));

    carousel.scrollLeft = 0;
    updateActiveButton(0);
  });
</script>

</BaseLayout>

<style >
  body {
    /* variable declarations */
    /* color variables */
    --accent-font-clr: hsl(30, 20%, 98%);
    --tagline-font-clr: hsl(26, 33%, 21%);
    --bkgrnd-clr1: hsl(37, 24%, 76%);
    --bkgrnd-clr1: hsl(23, 59%, 92%);
    --bkgrnd-clr2: hsl(30, 24%, 73%);
    --highlight-clr: hsl(39, 100%, 58%);

    /* number variables */
    --max-width: 1920px;
    --header-height: 60px;
    --card-width: clamp(31.25rem, 21.4968rem + 44.586vw, 75rem);
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      --card-width: calc(100vw - 0.5rem);
    }

    @media (orientation: landscape) and (min-width: 1000px) and (min-height: 500px) {
      --header-height: 45px;
    }
  }

  body {
    margin-inline: auto;
    position: relative;
  }

  body .body-wrapper {
    max-width: var(--max-width);
    width: 98%;
    background: var(--bkgrnd-clr1);
  }

  main {
    padding-top: var(--header-height);
    max-width: 100%;
    margin-inline: auto;
    color: var(--tagline-font-clr);
    font-size: clamp(1.75rem, 1.6385rem + 0.5096vw, 2.25rem);
    max-height: none;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      padding-bottom: 1rem;
    }
  }

  main p {
    font-size: 1rem;
    padding-bottom: 0.5rem;
  }

  .wardrobes-hero {
    position: relative;
    margin: 0;

    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      padding-top: 0;
    }
  }

  .wardrobes-hero-img-wrapper {
    position: relative;
  }

  .wardrobes-hero-img-wrapper::after {
    content: "";
    position: absolute;
    inset: 0;
    /* padding-top: var(--header-height); */
    background: linear-gradient(to right, var(--tagline-font-clr), transparent, var(--tagline-font-clr));
    mask: linear-gradient(transparent 10%, black);
    mix-blend-mode: multiply;
  }

  .wardrobes-hero picture {
    margin-inline: auto;
  }

  .wardrobes-hero img {
    margin-inline: auto;
    width: 100%;
  }

  .wardrobes-hero-text {
    position: absolute;
    /* inset: 2rem; */
    inset-inline: 0;
    bottom: clamp(20%, 50px, 2vh);

    display: grid;
    grid-template-columns: repeat(3, 1fr);
    row-gap: 5vw;
    color: var(--accent-font-clr);

    z-index: 5;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      bottom: clamp(15%, 50px, 2vh);
      grid-template-columns: repeat(2, 1fr);

      max-height: 80vh;
      row-gap: 15vw;
      column-gap: 1rem;
      padding-bottom: 1rem;
      padding-inline: 0;
      /* padding-top: clamp(100px, calc(30vh + 0.5rem), 60vh); */
    }

    @media (width < 500px) {
      padding-top: 20vw;
      row-gap: 2rem;

      grid-template-columns: auto;
      grid-template-rows: 3fr 1fr 0.3fr;
    }
  }

  .wardrobes-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    height: 100%;
    background: hsl(from var(--tagline-font-clr) h s l / 0.3);

    z-index: 1;
  }

  .wardrobes-hero-text h1 {
    font-size: calc(2rem + 1.5vh);
    padding-left: 2rem;
    align-self: end;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      font-size: 2.2rem;
      padding-left: 1rem;
    }
    @media (width < 500px) {
      align-self: center;
      font-size: 1.3rem;
    }
  }

  .wardrobes-hero-text p {
    grid-area: 2/1/3/2;
    font-size: clamp(1.2rem, 1.1331rem + 0.3057vw, 12rem);
    padding: 0;
    padding-left: 2rem;
    max-width: 30vw;
    /* text-transform: uppercase; */
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      max-width: none;
      font-size: 1.2rem;
      font-weight: 400;
      padding-left: 1rem;
    }
    @media (width < 500px) {
      align-self: start;
      padding-inline: 1rem;
      max-width: 80vw;
      font-size: 1rem;
    }
  }

  .hero-cta {
    grid-area: 3/2/4/3;
    justify-self: center;
    align-self: center;
    display: flex;
    flex-direction: column;
    align-items: center;

    color: var(--accent-font-clr);
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      grid-area: 2/2/3/3;
      justify-self: end;
      align-self: center;
      color: var(--accent-font-clr);
      font-size: 1rem;
    }
    @media (width < 500px) {
      grid-area: 3/1/4/2;
      font-size: 0.5rem;
      font-weight: 300;
      padding: 0;
      padding-left: 1rem;
      flex-direction: row;
      align-items: start;
      justify-self: start;
      align-self: end;
    }
  }

  .hero-cta p {
    font-size: 1rem;
    padding-left: 0;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      padding: 0;
      padding-right: 0.5rem;
      font-size: 0.8rem;
      text-align: center;
    }
  }

  .cta-arrow {
    width: 1.5rem;
    stroke: var(--accent-font-clr);
    stroke-width: 2;
    padding-block: 0.5rem;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      width: 1rem;
    }
    @media (width < 500px) {
      padding-bottom: 0;
      padding-top: 0.2rem;
    }
  }

  .card-container-wrapper {
    position: relative;
    z-index: 5;
    margin-inline: auto;
    overflow-x: auto;
    background: var(--bkgrnd-clr2);
    overflow-y: hidden;

    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    .card-container-wrapper::-webkit-scrollbar {
      display: none;
    }

    @media (width <= 1024px) {
      width: 100vw;
      padding: 1rem 0;
      background: var(--bkgrnd-clr1);
    }
  }

  .card-container {
    display: grid;
    width: fit-content;
    grid-template-columns: repeat(5, var(--card-width));
    grid-template-rows: auto;
    gap: 2rem;
    padding: 1rem 2rem;

    scroll-snap-align: start center;
    scroll-margin-top: 5rem;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      grid-template-columns: repeat(5, calc(var(--card-width) * 0.8));
      gap: 0;
    }
  }

  .card {
    position: relative;
    display: flex;
    width: var(--card-width);
    height: auto;
    border-radius: 5px;
    background: var(--bkgrnd-clr1);
    gap: 1rem;
    justify-content: right;
    align-items: center;
    scroll-snap-align: center;
    scroll-margin-inline: 10rem;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      flex-direction: column;
      gap: 0;
      width: 95%;
    }
  }

  .card.current {
    background: hsl(from var(--bkgrnd-clr1) h calc(s + 50) l);
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      outline: 3px solid var(--tagline-font-clr);
    }
  }

  .card-image-wrapper {
    position: relative;
  }

  .card-image-wrapper::after {
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(transparent 60%, var(--tagline-font-clr));
      mix-blend-mode: multiply;
      border-radius: 5px;
    }
  }

  .card > * {
    flex: 1;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      width: 100%;
    }
  }

  .card picture {
    display: block;
    height: 100%;
    width: 100%;
  }

  .card img,
  .card picture img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    padding: 1rem;
    border-radius: 5px;

    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      margin-inline: auto;
      height: 100%;
      padding: 0;
    }
  }

  .card-text {
    max-width: fit-content;
    padding-inline: 2rem;
    margin-inline: auto;
    z-index: 5;
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      position: absolute;
      padding: 0.5rem;
      top: 80%;
      color: var(--accent-font-clr);
    }
    @media (width < 500px) {
      top: 60%;
      font-size: 1rem;
    }
  }

  .card h2 {
    text-transform: uppercase;
    padding-bottom: 1rem;
  }

  .card .main-point {
    font-size: 1.5rem;
    font-style: italic;
    font-family: "Cormorant Garamond", serif;
    font-weight: 600;
    padding-bottom: 1rem;
  }

  :global(.carousel-buttons) {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
    
    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      /* position: absolute; */
      width: 100%;
      /* bottom: 0; */
      padding-block: 1rem;
      z-index: 10;
      margin-bottom: 2vh;
    }
  }

  :global(.carousel-button) {
    width: 10px;
    height: 10px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: #999;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  :global(.carousel-button:hover) {
    transform: scale(1.2);
  }

  :global(.carousel-button.active) {
    background: #000;
    transform: scale(1.2);
  }

  main .task-bar {
    bottom: 0;
  }

  body::after {
    content: "";
    position: absolute;
    inset: 0;
    top: calc(100% + 10vh);

    min-height: 50px;
    /* background: red; */
    z-index: 5;

    @media (width <= 1024px) and (max-height: 600px), (orientation: portrait) {
      top: 200%;
    }
  }
</style>
