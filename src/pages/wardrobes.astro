---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/wardrobe-style.css"
---

<BaseLayout bodyClass="wardrobes-body", mainClass="wardrobes-main">
  <div class="wardrobes-hero">
    <div class="wardrobes-hero-img-wrapper">
      <picture>
        <source srcset="/images/wardrobe-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="941" height="1082" />

        <source srcset="/images/wardrobe-landing-laptop-narrower.webp" media="(orientation: landscape)  and (max-height: 720px) and (min-width: 1000px)" width="1672" height="793" />

        <img src="/images/wardrobe-landing-laptop.webp" alt="image showing a modern, organised, sleek wardrobe" width="1920" height="1080" fetchpriority="high" width="1672" height="941" />
      </picture>
    </div>
    <div class="wardrobes-hero-text">
      <h1>
        One <br />
        Wardrobe. <br />
        Five Lives.
      </h1>
      <p>Because no two wardrobes should be designed the same way.</p>
      <a href="#card-container" class="hero-cta">
        <p>Same space. Endless possibilities.</p>
        <div class="cta-arrow">
          <svg xmlns="http://www.w3.org/2000/svg" width="31.887" height="15.912" viewBox="0 0 31.887 15.912">
            <path
              d="m693.24 657.027 15.599 14.86 15.598-14.86"
              style="
                    opacity: 0.721973;
                    fill: none;
                    fill-opacity: 0.85;
                    fill-rule: evenodd;
                    stroke-linecap: butt;
                    stroke-miterlimit: 2;
                    stroke-dasharray: none;
                    stroke-dashoffset: 20;
                    stroke-opacity: 1;
                  "
              transform="translate(-692.895 -656.665)"></path>
          </svg>
        </div>
      </a>
    </div>
  </div>

  <div class="card-container-wrapper">
    <div class="card-container" id="card-container">
      <div class="card minimalist">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/images/minimilist-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/images/minimilist-laptop.webp" alt="image showing a wardrobe for a minimalist" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE MINIMALIST</h2>
          <p class="main-point">Less, deliberately.</p>
          <p>Only what you need. Everything has its place.</p>
        </div>
      </div>
      <div class="card collector">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/images/collector-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/images/collector-laptop.webp" alt="image showing a wardrobe for a collector" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE COLLECTOR</h2>
          <p class="main-point">Make room for what matters.</p>
          <p>Because the things you love deserve to be seen—and stored properly.</p>
        </div>
      </div>
      <div class="card traveller">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/images/traveller-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/images/traveller-laptop.webp" alt="image showing a wardrobe for a traveller" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE TRAVELLER</h2>
          <p class="main-point">Come home. Unpack. Breathe.</p>
          <p>A place for the suitcase. A place for the everyday.</p>
        </div>
      </div>
      <div class="card couple">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/images/couple-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/images/couple-laptop.webp" alt="image showing a wardrobe for a couple" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE COUPLE</h2>
          <p class="main-point">Two people. One wardrobe.</p>
          <p>Different routines. Different needs. One beautifully resolved space.</p>
        </div>
      </div>
      <div class="card family">
        <div class="card-image-wrapper">
          <picture>
            <source srcset="/images/family-mobile.webp" media="((max-width: 1024px) and (max-height: 600px)) or (orientation: portrait)" width="1080" height="1456" />
            <img src="/images/family-laptop.webp" alt="image showing a wardrobe for a family" width="500" height="375" />
          </picture>
        </div>
        <div class="card-text">
          <h2>THE Family</h2>
          <p class="main-point">Life changes. Storage should too.</p>
          <p>School today. Work tomorrow. More life, eventually.</p>
        </div>
      </div>
    </div>
    
  </div>
  <div class="carousel-buttons"></div>

  

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const carousel = document.querySelector(".card-container-wrapper");
    const cards = [...document.querySelectorAll(".card")];
    const buttonsContainer = document.querySelector(".carousel-buttons");

    if (!carousel || !buttonsContainer || cards.length === 0) {
      console.warn("Carousel elements were not found.");
      return;
    }

    const buttons = [];

    cards.forEach((card, index) => {
      const button = document.createElement("button");

      button.type = "button";
      button.className = "carousel-button";
      button.setAttribute("aria-label", `Go to card ${index + 1}`);

      if (index === 0) {
        button.classList.add("active");
      }

      button.addEventListener("click", () => {
  console.log(`first`)

        const carouselCenter = carousel.clientWidth / 2;
        const cardCenter = card.offsetLeft + card.offsetWidth / 2;

        carousel.scrollTo({
          left: cardCenter - carouselCenter,
          behavior: "smooth",
        });

        updateActiveButton(index);
      });

      buttonsContainer.appendChild(button);
      buttons.push(button);
    });

    function updateActiveButton(index) {
      buttons.forEach((button, buttonIndex) => {
        button.classList.toggle("active", buttonIndex === index);
      });
    }

    const observer = new IntersectionObserver(
      (entries) => {
        const visibleEntry = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

        if (!visibleEntry) return;

        const index = cards.indexOf(visibleEntry.target);

        cards.forEach((card) => {
          card.classList.remove("current");
        });

        visibleEntry.target.classList.add("current");
        updateActiveButton(index);
      },
      {
        root: carousel,
        threshold: [0.6],
      },
    );

    cards.forEach((card) => observer.observe(card));

    carousel.scrollLeft = 0;
    updateActiveButton(0);
  });
</script>

</BaseLayout>


